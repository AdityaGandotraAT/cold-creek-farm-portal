PORT=3000
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cold_creek_farm_portal
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false

# Production (Vercel + Neon): use the pooled connection string instead of DB_HOST / DB_NAME / DB_USER / DB_PASSWORD.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required in production. Use a long random value — do not ship the placeholder.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

# Public portal base URL used in welcome emails (no trailing slash).
PORTAL_URL=http://localhost:3000

# SMTP (Resend or any provider). Do not commit real SMTP passwords.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_SECURE=false
# Use onboarding@resend.dev until coldcreekfarm.com is verified, then jeff@coldcreekfarm.com
SMTP_FROM=onboarding@resend.dev
# Owner copy on every portal email (welcome, booking, vendor).
SMTP_OWNER_EMAIL=jeff@coldcreekfarm.com
SMTP_REPLY_TO=jeff@coldcreekfarm.com
